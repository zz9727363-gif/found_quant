import os
from decimal import Decimal

# 保留本机代理配置，在获取行情之前设置。
os.environ["HTTP_PROXY"] = "http://127.0.0.1:7897"
os.environ["HTTPS_PROXY"] = "http://127.0.0.1:7897"

import pandas as pd
import yfinance as yf

BASE_AMOUNT = 10  # 基础定投金额，单位：元


def calculate_investment_amount(change_percent):
    # 包含恰好下跌或上涨 2% 的情况。
    if change_percent <= -2:
        return BASE_AMOUNT * 2
    if change_percent >= 2:
        return 0
    return BASE_AMOUNT


def main():
    try:
        # 获取最近一个月日线，自动跳过周末及休市日。
        history = yf.Ticker("^NDX").history(
            period="1mo", interval="1d", auto_adjust=False,
            timeout=20,
        )
        if history.empty or "Close" not in history.columns:
            raise ValueError("未获取到行情，请检查代理或稍后重试。")
        closes = pd.to_numeric(history["Close"], errors="coerce").dropna().sort_index()
        if len(closes) < 2:
            raise ValueError("有效行情不足两个交易日。")

        # 使用十进制数，避免浮点误差影响阈值判断。
        previous_close = Decimal(str(closes.iloc[-2]))
        latest_close = Decimal(str(closes.iloc[-1]))
        if not all(p.is_finite() and p > 0 for p in (previous_close, latest_close)):
            raise ValueError("收盘价必须为有效正数。")
        change_percent = (latest_close - previous_close) / previous_close * 100
        final_amount = calculate_investment_amount(change_percent)

        if final_amount == BASE_AMOUNT * 2:
            message = "触发大跌奖励：跌幅大于等于 2%，定投翻倍！"
        elif final_amount == 0:
            message = "触发大涨暂停：涨幅大于等于 2%，暂停定投。"
        else:
            message = "常规定投：按基础金额买入。"

        # 打印中文行情和规则计算结果。
        print("=" * 52)
        print("纳斯达克100指数 · 智能定投计算器")
        print(f"最新行情日期：{closes.index[-1]:%Y-%m-%d}")
        print(f"前一交易日期：{closes.index[-2]:%Y-%m-%d}")
        print(f"前一交易日收盘价：{previous_close:,.2f} 点")
        print(f"最新日线价格：{latest_close:,.2f} 点")
        print(f"单日涨跌幅：{change_percent:+.4f}%")
        print(f"基础定投金额：{BASE_AMOUNT} 元")
        print("-" * 52)
        print(message)
        print(f"按设定规则，最终建议今天买入：{final_amount} 元")
        print("=" * 52)
        print("提示：行情可能延迟；未收盘时最新日线价格仍会变化。")
        print("休市日沿用最近交易日数据；本脚本不会自动下单。")
    except Exception as error:
        print(f"计算失败：{error}")
        raise SystemExit(1)


if __name__ == "__main__":
    main()

