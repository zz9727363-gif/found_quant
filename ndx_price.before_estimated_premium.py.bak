import os
from decimal import Decimal

# 保留本机代理配置，在获取行情之前设置。
os.environ["HTTP_PROXY"] = "http://127.0.0.1:7897"
os.environ["HTTPS_PROXY"] = "http://127.0.0.1:7897"

import pandas as pd
import yfinance as yf
import json
import subprocess
import sys
import requests
import time
from datetime import datetime
from zoneinfo import ZoneInfo

BASE_AMOUNT = 10  # 基础定投金额，单位：元
ETF_CODE = "513100"  # 可改为 "159941"
PREMIUM_LIMIT = Decimal("3")


def calculate_investment_amount(change_percent, premium_percent):
    # 溢价风控优先于指数涨跌幅；恰好 3% 仍执行原规则。
    if premium_percent > PREMIUM_LIMIT:
        return 0
    # 包含恰好下跌或上涨 2% 的情况。
    if change_percent <= -2:
        return BASE_AMOUNT * 2
    if change_percent >= 2:
        return 0
    return BASE_AMOUNT


def parse_etf_quote(row):
    # 必须使用 IOPV，不用前一天的基金净值替代。
    price = Decimal(str(row.get("最新价")))
    iopv = Decimal(str(row.get("IOPV实时估值")))
    if not all(x.is_finite() and x > 0 for x in (price, iopv)):
        raise ValueError("ETF 价格或 IOPV 缺失、为零或无效")
    timestamp = pd.to_datetime(row.get("更新时间"), errors="coerce", utc=True)
    if pd.isna(timestamp):
        raise ValueError("ETF 行情缺少有效更新时间")
    timestamp = timestamp.tz_convert("Asia/Shanghai")
    age = datetime.now(ZoneInfo("Asia/Shanghai")) - timestamp.to_pydatetime()
    # 休市时允许展示最近行情，但过旧或未来时间的数据不能参与建议。
    if age.total_seconds() < -300 or age.total_seconds() > 4 * 86400:
        raise ValueError("ETF 行情时间异常或已超过四天")
    return price, iopv, (price / iopv - 1) * 100, timestamp


def domestic_request_environment():
    # 只为国内行情子进程创建直连环境，主进程的代理保持原样。
    # 同时清除大小写 HTTP(S)_PROXY、ALL_PROXY 等变量。
    env = {key: value for key, value in os.environ.items()
           if not key.lower().endswith("_proxy")}
    # 禁止 requests 从 Windows 系统代理设置中再次取得代理。
    env.update({"NO_PROXY": "*", "no_proxy": "*", "PYTHONIOENCODING": "utf-8"})
    return env


class DomesticSession(requests.Session):
    """国内行情专用：直连、浏览器请求头、超时及最多两次尝试。"""

    def __init__(self):
        super().__init__()
        self.trust_env = False
        self.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                          "AppleWebKit/537.36 (KHTML, like Gecko) "
                          "Chrome/130.0.0.0 Safari/537.36",
            "Accept": "application/json, text/javascript, */*; q=0.01",
            "Accept-Language": "zh-CN,zh;q=0.9",
        })

    def request(self, method, url, **kwargs):
        headers = dict(kwargs.pop("headers", {}) or {})
        headers.setdefault("Referer", "https://finance.sina.com.cn/"
                           if "sina.com.cn" in url else "https://quote.eastmoney.com/")
        kwargs.update(headers=headers, proxies={"http": None, "https": None})
        kwargs["timeout"] = kwargs.get("timeout") or 8
        # 两次总尝试，即失败后等待 2 秒，再重试一次。
        for attempt in range(2):
            try:
                response = super().request(method, url, **kwargs)
                response.raise_for_status()
                return response
            except requests.RequestException:
                if attempt == 1:
                    raise
                time.sleep(2)


def run_akshare_source(source):
    # AKShare 不接收 session 参数，故仅在隔离子进程中替换其 requests.get。
    # 不影响主进程以及 yfinance；整个子进程最多等待 30 秒。
    worker = r"""
import json
import runpy
import sys
from unittest.mock import patch
module = runpy.run_path(sys.argv[1])
import akshare as ak
with module['DomesticSession']() as session:
    with patch('requests.get', session.get), patch('requests.post', session.post):
        frame = (ak.fund_etf_spot_em() if sys.argv[3] == 'eastmoney'
                 else ak.fund_etf_category_sina(symbol='ETF基金'))
code = frame['代码'].astype(str).str.replace(r'^(sh|sz)', '', regex=True).str.zfill(6)
rows = frame.loc[code == sys.argv[2]]
if len(rows) != 1:
    raise ValueError('未找到唯一的目标 ETF 行情')
print(rows.to_json(orient='records', force_ascii=False, date_format='iso'))
"""
    result = subprocess.run(
        [sys.executable, "-c", worker, os.path.abspath(__file__), ETF_CODE, source],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
        timeout=30, env=domestic_request_environment(),
    )
    if result.returncode:
        detail = result.stderr.strip().splitlines()
        # 只报告错误类型，不把冗长的接口地址打印到终端。
        raise ValueError(detail[-1].split(":", 1)[0] if detail else "接口请求失败")
    return json.loads(result.stdout.strip().splitlines()[-1])[0]


def get_eastmoney_quote():
    # 同源单只 ETF 备用接口，避免必须下载全市场数据。
    market = "1" if ETF_CODE.startswith("5") else "0"
    with DomesticSession() as session:
        response = session.get(
            "https://push2delay.eastmoney.com/api/qt/clist/get",
            params={"pn": 1, "pz": 2, "fltt": 2, "invt": 2,
                    "fs": f"i:{market}.{ETF_CODE}", "fid": "f12", "po": 1,
                    "fields": "f12,f14,f2,f441,f124"},
        )
        data = response.json().get("data") or {}
        quotes = data.get("diff") or []
        quotes = list(quotes.values()) if isinstance(quotes, dict) else quotes
        rows = [q for q in quotes if str(q.get("f12")) == ETF_CODE]
        if len(rows) != 1:
            raise ValueError("目标 ETF 行情不可用")
        q = rows[0]
        timestamp = pd.to_datetime(q.get("f124"), unit="s", utc=True, errors="coerce")
        return {"最新价": q.get("f2"), "IOPV实时估值": q.get("f441"),
                "更新时间": timestamp}


def get_etf_quote():
    sources = [
        ("AKShare 东财", lambda: run_akshare_source("eastmoney")),
        ("东财单只 ETF 备用接口", get_eastmoney_quote),
        ("AKShare 新浪备用接口", lambda: run_akshare_source("sina")),
    ]
    for name, fetch in sources:
        print(f"正在尝试：{name}（直连，失败后间隔 2 秒重试一次）", flush=True)
        try:
            row = fetch()
            if "IOPV实时估值" not in row:
                print(f"{name} 返回最新价：{row.get('最新价')} 元；"
                      "但接口没有 IOPV，不能计算溢价率。", flush=True)
                continue
            quote = parse_etf_quote(row)
            print(f"行情来源：{name}", flush=True)
            return quote
        except Exception as error:
            print(f"{name} 不可用（{type(error).__name__}），继续尝试备用源。", flush=True)
    raise ValueError("所有数据源均未取得有效价格、IOPV 和行情时间")


def main():
    try:
        # 首先获取国内 ETF 的价格和 IOPV，并计算溢价率。
        print(f"正在检查 ETF {ETF_CODE} 的价格和 IOPV……", flush=True)
        try:
            price, iopv, premium_percent, quote_time = get_etf_quote()
        except Exception as error:
            print("当前 ETF 溢价率：无法核实")
            print(f"行情获取失败（{type(error).__name__}）：国内行情已直连，请检查网络或稍后重试。")
            print("数据不可用，暂停定投。最终建议今天买入：0 元")
            return
        print(f"ETF 代码：{ETF_CODE}")
        print(f"行情更新时间（北京时间）：{quote_time:%Y-%m-%d %H:%M:%S}")
        print(f"ETF 最新价格：{price:.4f} 元；IOPV：{iopv:.4f} 元")
        print(f"当前 ETF 溢价率：{premium_percent:+.4f}%")
        print("以上为接口最近可用行情；非交易时段不代表实时行情。")
        if premium_percent > PREMIUM_LIMIT:
            print("溢价过高，规避风险")
            print("最终建议今天买入：0 元（无视指数涨跌幅）")
            return

        # 溢价不超过 3% 时，继续计算纳指涨跌幅。
        history = yf.Ticker("^NDX").history(
            period="1mo", interval="1d", auto_adjust=False,
            timeout=20,
        )
        if history.empty or "Close" not in history.columns:
            raise ValueError("未获取到行情，请检查代理或稍后重试。")
        closes = pd.to_numeric(history["Close"], errors="coerce").dropna().sort_index()
        if len(closes) < 2:
            raise ValueError("有效行情不足两个交易日。")

        # 使用十进制数，避免浮点误差影响阈值判断。
        previous_close = Decimal(str(closes.iloc[-2]))
        latest_close = Decimal(str(closes.iloc[-1]))
        if not all(p.is_finite() and p > 0 for p in (previous_close, latest_close)):
            raise ValueError("收盘价必须为有效正数。")
        change_percent = (latest_close - previous_close) / previous_close * 100
        final_amount = calculate_investment_amount(change_percent, premium_percent)

        if final_amount == BASE_AMOUNT * 2:
            message = "触发大跌奖励：跌幅大于等于 2%，定投翻倍！"
        elif final_amount == 0:
            message = "触发大涨暂停：涨幅大于等于 2%，暂停定投。"
        else:
            message = "常规定投：按基础金额买入。"

        # 打印中文行情和规则计算结果。
        print("=" * 52)
        print("纳斯达克100指数 · 智能定投计算器")
        print(f"最新行情日期：{closes.index[-1]:%Y-%m-%d}")
        print(f"前一交易日期：{closes.index[-2]:%Y-%m-%d}")
        print(f"前一交易日收盘价：{previous_close:,.2f} 点")
        print(f"最新日线价格：{latest_close:,.2f} 点")
        print(f"单日涨跌幅：{change_percent:+.4f}%")
        print(f"基础定投金额：{BASE_AMOUNT} 元")
        print("-" * 52)
        print(message)
        print(f"按设定规则，最终建议今天买入：{final_amount} 元")
        print("=" * 52)
        print("提示：行情可能延迟；未收盘时最新日线价格仍会变化。")
        print("休市日沿用最近交易日数据；本脚本不会自动下单。")
    except Exception as error:
        print(f"计算失败：{error}")
        print("数据不可用，暂停定投。最终建议今天买入：0 元")
        return


if __name__ == "__main__":
    main()


