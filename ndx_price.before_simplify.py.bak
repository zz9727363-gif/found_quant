import os
from decimal import Decimal

# 保留本机代理配置，在获取行情之前设置。
os.environ["HTTP_PROXY"] = "http://127.0.0.1:7897"
os.environ["HTTPS_PROXY"] = "http://127.0.0.1:7897"

import pandas as pd
import yfinance as yf
import json
import subprocess
import sys
import requests
import time
from datetime import datetime
from zoneinfo import ZoneInfo

BASE_AMOUNT = 10  # 基础定投金额，单位：元
ETF_CODE = "513100"  # 可改为 "159941"
PREMIUM_LIMIT = Decimal("3")
# 用户提供的近似基准，非接口获取的官方净值；只适用于指定 ETF。
BASE_NAV = Decimal("2.24")
BASE_NAV_ETF_CODE = "513100"
BASE_NAV_DATE = "未指定（手工假设）"  # 知道真实基准日期后请更新



def calculate_investment_amount(change_percent, premium_percent):
    # 溢价风控优先于指数涨跌幅；恰好 3% 仍执行原规则。
    if premium_percent > PREMIUM_LIMIT:
        return 0
    # 包含恰好下跌或上涨 2% 的情况。
    if change_percent <= -2:
        return BASE_AMOUNT * 2
    if change_percent >= 2:
        return 0
    return BASE_AMOUNT


def estimate_premium(price, base_nav, change_percent):
    # 简化模型：估算净值 = 基准净值 ×（1 + 纳指单日涨跌幅 / 100）。
    # 不计汇率、费用、跟踪误差；基准若已包含这次涨跌，不能重复应用。
    price, base_nav, change_percent = map(
        lambda value: Decimal(str(value)), (price, base_nav, change_percent)
    )
    if not all(value.is_finite() for value in (price, base_nav, change_percent)):
        raise ValueError("价格、基准净值和涨跌幅必须是有效数值")
    if price <= 0 or base_nav <= 0 or change_percent <= -100:
        raise ValueError("价格或基准净值必须为正，涨跌幅必须大于 -100%")
    estimated_nav = base_nav * (1 + change_percent / 100)
    estimated_premium = (price / estimated_nav - 1) * 100
    return estimated_nav, estimated_premium


def domestic_request_environment():
    # 只为国内行情子进程创建直连环境，主进程的代理保持原样。
    # 同时清除大小写 HTTP(S)_PROXY、ALL_PROXY 等变量。
    env = {key: value for key, value in os.environ.items()
           if not key.lower().endswith("_proxy")}
    # 禁止 requests 从 Windows 系统代理设置中再次取得代理。
    env.update({"NO_PROXY": "*", "no_proxy": "*", "PYTHONIOENCODING": "utf-8"})
    return env


class DomesticSession(requests.Session):
    """国内行情专用：直连、浏览器请求头、超时及最多两次尝试。"""

    def __init__(self):
        super().__init__()
        self.trust_env = False
        self.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                          "AppleWebKit/537.36 (KHTML, like Gecko) "
                          "Chrome/130.0.0.0 Safari/537.36",
            "Accept": "application/json, text/javascript, */*; q=0.01",
            "Accept-Language": "zh-CN,zh;q=0.9",
        })

    def request(self, method, url, **kwargs):
        headers = dict(kwargs.pop("headers", {}) or {})
        headers.setdefault("Referer", "https://finance.sina.com.cn/"
                           if "sina.com.cn" in url else "https://quote.eastmoney.com/")
        kwargs.update(headers=headers, proxies={"http": None, "https": None})
        kwargs["timeout"] = kwargs.get("timeout") or 8
        # 两次总尝试，即失败后等待 2 秒，再重试一次。
        for attempt in range(2):
            try:
                response = super().request(method, url, **kwargs)
                response.raise_for_status()
                return response
            except requests.RequestException:
                if attempt == 1:
                    raise
                time.sleep(2)


def run_akshare_source(source):
    # AKShare 不接收 session 参数，故仅在隔离子进程中替换其 requests.get。
    # 不影响主进程以及 yfinance；整个子进程最多等待 30 秒。
    worker = r"""
import json
import runpy
import sys
from unittest.mock import patch
module = runpy.run_path(sys.argv[1])
import akshare as ak
with module['DomesticSession']() as session:
    with patch('requests.get', session.get), patch('requests.post', session.post):
        frame = (ak.fund_etf_spot_em() if sys.argv[3] == 'eastmoney'
                 else ak.fund_etf_category_sina(symbol='ETF基金'))
code = frame['代码'].astype(str).str.replace(r'^(sh|sz)', '', regex=True).str.zfill(6)
rows = frame.loc[code == sys.argv[2]]
if len(rows) != 1:
    raise ValueError('未找到唯一的目标 ETF 行情')
print(rows.to_json(orient='records', force_ascii=False, date_format='iso'))
"""
    result = subprocess.run(
        [sys.executable, "-c", worker, os.path.abspath(__file__), ETF_CODE, source],
        capture_output=True, text=True, encoding="utf-8", errors="replace",
        timeout=30, env=domestic_request_environment(),
    )
    if result.returncode:
        detail = result.stderr.strip().splitlines()
        # 只报告错误类型，不把冗长的接口地址打印到终端。
        raise ValueError(detail[-1].split(":", 1)[0] if detail else "接口请求失败")
    return json.loads(result.stdout.strip().splitlines()[-1])[0]


def get_etf_price():
    # 新浪价格每次运行重新获取，绝不把之前的 2.243 当作实时数据硬编码。
    print(f"正在从新浪获取 ETF {ETF_CODE} 最新可用价格（国内直连）……", flush=True)
    row = run_akshare_source("sina")
    price = Decimal(str(row.get("最新价")))
    if not price.is_finite() or price <= 0:
        raise ValueError("新浪未返回有效的 ETF 价格")
    return price


def main():
    try:
        if ETF_CODE != BASE_NAV_ETF_CODE:
            raise ValueError("更换 ETF 后，请同步设置对应的基准净值和 BASE_NAV_ETF_CODE")
        price = get_etf_price()
        fetched_at = datetime.now(ZoneInfo("Asia/Shanghai"))
        print("正在通过代理获取纳斯达克100指数日线……", flush=True)
        history = yf.Ticker("^NDX").history(
            period="1mo", interval="1d", auto_adjust=False, timeout=20,
        )
        if history.empty or "Close" not in history.columns:
            raise ValueError("未取得纳指行情，请检查代理或稍后重试")
        closes = pd.to_numeric(history["Close"], errors="coerce").dropna().sort_index()
        if len(closes) < 2:
            raise ValueError("有效纳指行情不足两个交易日")
        previous_close = Decimal(str(closes.iloc[-2]))
        latest_close = Decimal(str(closes.iloc[-1]))
        if not all(value.is_finite() and value > 0 for value in (previous_close, latest_close)):
            raise ValueError("纳指收盘价异常")
        change_percent = (latest_close - previous_close) / previous_close * 100
        estimated_nav, premium_percent = estimate_premium(price, BASE_NAV, change_percent)
        final_amount = calculate_investment_amount(change_percent, premium_percent)

        if premium_percent > PREMIUM_LIMIT:
            message = "预估溢价过高，规避风险：暂停定投。"
        elif change_percent <= -2:
            message = "触发大跌奖励：定投金额翻倍！"
        elif change_percent >= 2:
            message = "触发大涨暂停：本次暂停定投。"
        else:
            message = "常规定投：按基础金额买入。"

        print("=" * 60)
        print("纳指 ETF · 估算溢价定投计算器")
        print(f"ETF 代码：{ETF_CODE}；新浪最新可用价格：{price:.4f} 元")
        print(f"价格获取时间（北京时间）：{fetched_at:%Y-%m-%d %H:%M:%S}")
        print("新浪此接口未返回成交日期；获取时间不代表成交时间。")
        print(f"纳指行情日期：{closes.index[-2]:%Y-%m-%d} → {closes.index[-1]:%Y-%m-%d}")
        print(f"纳指单日涨跌幅：{change_percent:+.4f}%")
        print(f"手工基准净值：{BASE_NAV:.4f} 元；基准日期：{BASE_NAV_DATE}")
        print(f"估算净值 = {BASE_NAV:.4f} × (1 + {change_percent:.6f}% / 100)")
        print(f"估算净值：{estimated_nav:.6f} 元")
        print(f"这是估算的溢价率：{premium_percent:+.4f}%（非官方 IOPV 溢价率）")
        print("-" * 60)
        print(message)
        print(f"按设定规则，最终建议今天买入：{final_amount} 元")
        print("=" * 60)
        print("估算未计汇率、费用和跟踪误差；基准日期及行情时点需匹配。")
        print("当前 2.24 为手工假设，请按真实基准净值及日期更新。")
        print("休市时沿用最新可用行情；未收盘日线可能变化。本脚本不会下单。")
    except Exception as error:
        print(f"计算失败（{type(error).__name__}）：{error}")
        print("数据不可用，暂停定投。最终建议今天买入：0 元")


if __name__ == "__main__":
    main()
